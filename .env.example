# ==========================================
# AI Agent 平台环境变量配置
# 复制为 .env 后修改对应值
# ==========================================

# ---------- 应用 ----------
# dev / production（影响日志级别等）
APP_ENV=production

# ---------- 数据库 ----------
# 数据库端口（宿主机映射）
DB_PORT=5432
DB_PASSWORD=postgres

# ---------- 后端服务 ----------
# 后端 API 端口（宿主机映射，容器内固定 8080）
SERVER_PORT=8080
# JWT 密钥（生产环境务必修改）
JWT_SECRET=aiagent-secret-key-change-me-in-production
# Token 有效期（小时）
TOKEN_EXPIRE_HOURS=24

# ---------- 调用观测 ----------
# 是否记录 Embedding（向量）调用日志：默认 false，
# 向量调用频率高、单价低，会淹没 LLM 记录；核对向量成本时改 true
LOG_EMBEDDING=false

# ---------- 前端 / Nginx ----------
# 前端（Nginx 网关）端口（compose 默认 80；这里用 6080 避免与常用 80 冲突）
WEB_PORT=6080
